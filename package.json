{
  "name": "the-last-way-out",
  "version": "1.0.0",
  "description": "The Last Way Out - a grounded psychological horror game (Ubuntu / desktop)",
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "Nishan & Nishant",
    "email": "nishan@example.com"
  },
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "run":"./run.sh",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --linux AppImage deb",
    "web": "npm run build && vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "cannon-es": "0.20.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "vite": "8.3.8"
  },
  "overrides": {
    "minimatch": "11.0.9"
  },
  "build": {
    "appId": "com.nishan.thelastwayout",
    "productName": "The Last Way Out",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "Nishan <nishan@example.com>"
    }
  }
}
